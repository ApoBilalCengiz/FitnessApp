<Application x:Class="FitnessApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FitnessApp"
             xmlns:conv="clr-namespace:FitnessApp.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/AppTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <conv:EqualValueConverter x:Key="EqualValueConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
